---
//component import
import MainHead from "./MainHead.astro"
import Footer from "../components/Footer.astro"
import NavAstroComponent from "../components/NavAstroComponent.astro";

// style import
import "../styles/global.css"
import "../styles/MainLayout.css"

const {
    title = "My Astro Blog",
    description = "My journey on the algorithms"
} = Astro.props;
---

<html lang="en">
	<MainHead {title} {description}/>
	<body>
		<NavAstroComponent />
		<slot></slot>
		<Footer />
	</body>
</html>
