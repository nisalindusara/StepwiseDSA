---
// component imports
import MainLayout from "../../layouts/MainLayout.astro";
import PostCard from "../../components/PostCard.astro";
import styles from "virtual:astro:image-styles.css";

const allPosts = Object.values(import.meta.glob("./*.md", { eager: true }));

styles
---

<MainLayout title="My Blog">
    <main>
        {
            allPosts.map((post:any) => <PostCard frontmatter={post.frontmatter} url={post.url}/>)
        }
    </main>
</MainLayout>

<style>
    main {
    max-width: 1000px;
    margin: 20px auto 0;
    padding: 0 24px 40px;
  }
</style>